interface dev.rockorager.ouro.Settings

type RGB (r: float, g: float, b: float)
type OutputMatch (name: ?string, connector_id: ?int, connector_type: ?int, connector_type_id: ?int, width_mm: ?int, height_mm: ?int)
type Appearance (color_scheme: (default, light, dark), accent: ?RGB)
type Wallpaper (image: ?string, fit: (fill, fit, stretch, center, tile), fallback: RGB)
type OutputWallpaper (match: OutputMatch, wallpaper: Wallpaper)
type Wallpapers (default: Wallpaper, outputs: []OutputWallpaper)
# Compositor is Ouro config JSON: general, bindings, input_rules, output_rules.
# Preserve omitted members, null deletions, default resets and dynamic names.
# Ouro, not this store, validates/applies the contents of these four members.
type Settings (appearance: Appearance, compositor: object, preferred_output: ?OutputMatch, wallpaper: Wallpapers)
type Section (appearance, compositor, preferred_output, wallpaper)

method Get() -> (revision: string, settings: Settings)
method Set(expected_revision: string, settings: Settings) -> (revision: string, settings: Settings)
# Replace one complete section, never merge. Required value except for
# preferred_output: omitted/null clears it. Other sections reject omitted/null.
# Uses the same global revision and Watch stream as Set; no-ops do not publish.
method SetSection(expected_revision: string, section: Section, value: ?object) -> (revision: string, settings: Settings)
method Watch() -> (revision: string, settings: Settings)

# RFC 6901 string pointer relative to Settings; empty path selects its root.
# Requires more:true. Initial selection, then only changes, with continues:true.
# value_json contains JSON text of any type; absent is exists:false/value_json:"null".
# Stored null is exists:true/value_json:"null". Invalid pointers: InvalidParameter(path).
# revision is current at emission; unrelated commits may advance it silently.
method WatchPath(path: string) -> (revision: string, exists: bool, value_json: string)

error Conflict(revision: string)
error PersistenceFailed()
